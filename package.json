{
  "name": "dsh-cwtools",
  "version": "0.2.0",
  "description": "Native DeepSeek Harness tools and settings for CWTools Paradox modding",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "packageManager": "pnpm@11.24.0",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-general"
      ]
    }
  },
  "scripts": {
    "build": "pnpm run typecheck && pnpm run build:types && tsdown",
    "build:types": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:host": "vitest run tests/host",
    "test:client": "vitest run tests/client",
    "prepack": "pnpm run build",
    "prepare": "tsdown"
  },
  "engines": {
    "node": ">=24.9.0",
    "dsh": ">=0.2.2-rc.1 <0.3.0"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.19.0",
    "cwtools-node": "0.2.0",
    "cwtools-shared": "0.3.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.1.0",
    "@deepseek-ai/dsh-system-prompt": ">=0.2.2-rc.1 <0.3.0",
    "@deepseek-ai/dsh-tools": ">=0.2.2-rc.1 <0.3.0",
    "@deepseek-ai/dsh-working-directory": ">=0.2.2-rc.1 <0.3.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.1.0",
    "@deepseek-ai/cordis-plugin-loader": "^1.1.0",
    "@deepseek-ai/dsh-api-remotes": ">=0.2.2-rc.1 <0.3.0",
    "@deepseek-ai/dsh-client-locale": ">=0.2.2-rc.1 <0.3.0",
    "@deepseek-ai/dsh-client-store": ">=0.2.2-rc.1 <0.3.0",
    "@deepseek-ai/dsh-client-ui-primitives": ">=0.2.2-rc.1 <0.3.0",
    "@deepseek-ai/dsh-client-ui-renderer": ">=0.2.2-rc.1 <0.3.0",
    "@deepseek-ai/dsh-client-ui-settings": ">=0.2.2-rc.1 <0.3.0",
    "@deepseek-ai/dsh-client-ui-settings-general": ">=0.2.2-rc.1 <0.3.0",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.2.2-rc.1 <0.3.0",
    "@deepseek-ai/dsh-system-prompt": ">=0.2.2-rc.1 <0.3.0",
    "@deepseek-ai/dsh-tools": ">=0.2.2-rc.1 <0.3.0",
    "@deepseek-ai/dsh-util-code-language": "0.1.7-rc.2",
    "@deepseek-ai/dsh-util-workspace-path": "0.1.2-alpha.2",
    "@deepseek-ai/dsh-working-directory": ">=0.2.2-rc.1 <0.3.0",
    "@shikijs/langs": "^4.6.0",
    "@testing-library/react": "^16.3.0",
    "@types/mdast": "^4.0.4",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "anser": "^2.3.5",
    "clsx": "^2.1.1",
    "diff": "^9.0.0",
    "immer": "^10.2.0",
    "jsdom": "^26.1.0",
    "katex": "^0.19.1",
    "lightningcss": "^1.30.0",
    "mdast-util-from-markdown": "^2.1.0",
    "mdast-util-gfm": "^3.1.0",
    "mdast-util-math": "^3.0.0",
    "micromark-core-commonmark": "^2.0.4",
    "micromark-extension-gfm": "^3.0.0",
    "micromark-extension-math": "^3.1.0",
    "micromark-factory-space": "^2.1.0",
    "micromark-util-character": "^2.1.1",
    "micromark-util-classify-character": "^2.0.1",
    "micromark-util-decode-string": "^2.0.1",
    "micromark-util-sanitize-uri": "^2.0.1",
    "micromark-util-symbol": "^2.0.1",
    "micromark-util-types": "^2.0.3",
    "playwright-core": "^1.56.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "shiki": "^4.6.0",
    "simple-icons": "^16.37.0",
    "tsdown": "^0.22.2",
    "typescript": "^5.8.3",
    "vitest": "^4.0.0",
    "zustand": "~4.5.7"
  }
}